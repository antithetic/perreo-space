---
import Layout from '@layouts/Layout.astro'
---

<Layout>
  <div class="lh-container">
    <h1>Love Hangover</h1>
  </div>
</Layout>

<style>
  @reference '@styles/global.css';

  h1 {
    @apply fl-text-4xl/9xl font-bold;
    @apply underline decoration-3;
    font-family: 'schwarzkopf-new', sans-serif;
    font-weight: 400;
    font-style: normal;
  }

  .lh-container {
    @apply container mx-auto text-center flex flex-col items-center justify-center h-screen;
  }
</style>
